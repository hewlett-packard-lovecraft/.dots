### autostart

# Launch and format the dropdown terminal
exec foot -t "Dropdown Terminal"

for_window [title="Dropdown Terminal"] {
    floating enable
    border none
    resize set width 100 ppt height 40 ppt
    move absolute position center
    move to scratchpad
}

# Keybinding to toggle the dropdown (e.g., F12) 
bindsym F12 [title="Dropdown Terminal"] scratchpad show

exec swaymsg "workspace 1; exec keepassxc --minimized;"
exec swaymsg "workspace 1; exec onedrivegui;"
exec swaymsg "workspace 1; exec blueman-applet;"
exec swaymsg "workspace 1; exec nm-applet --indicator;"
